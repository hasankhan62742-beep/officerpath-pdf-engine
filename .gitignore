.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
# M1: local storage root (uploaded originals must never be committed).
var/
# M1: local test databases.
*.db
*.sqlite3
# Keystores / signing material (audit D10).
*.keystore
*.jks
key.properties
# Alembic / editor artefacts.
.mypy_cache/
.ruff_cache/
# M8: benchmark run logs are intermediate stdout dumps — the JSON +
# markdown in docs/benchmarks/ are the deliverables. Logs stay on
# disk locally, out of the repo (M6/M7 decision, recorded in M8).
docs/benchmarks/*.log
# M8: coverage data file (regenerated by every --cov run).
.coverage
# Phase 2 M2: Node / Next.js artefacts (web/ is the Next.js app).
node_modules/
.next/
out/
# Phase 2 M2: local frontend env (never commit real values).
web/.env.local
web/.env*.local
