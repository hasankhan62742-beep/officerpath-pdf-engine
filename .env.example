# OfficerPath AI — PDF Engine (Phase 1, M1)
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Placeholders only — no real keys, ever.

# App
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Supabase (project: officerpath-ai, ref gliebuyyjguxrwdfuakz)
SUPABASE_URL=https://gliebuyyjguxrwdfuakz.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key: server-side ONLY. Never put it in the Flutter app,
# never return it in an API response, never log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Engine-owned database (SQLAlchemy + Alembic, ADR-003). Same Postgres
# database Supabase hosts. Optional: without it the API still serves
# (stage history is logged, not persisted). Example:
# DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.gliebuyyjguxrwdfuakz.supabase.co:5432/postgres
DATABASE_URL=

# Storage backend: "local" only in M1. Local root (relative to repo).
STORAGE_BACKEND=local
STORAGE_ROOT=var/storage

# Ingestion limits (prompt §6). Override per environment if needed.
# MAX_FILE_SIZE_BYTES=104857600
# MAX_PAGES_PER_JOB=100
# MAX_IMAGE_DIMENSION_PX=12000
# MAX_IMAGE_PIXELS=25000000
# MAX_DECOMPRESSION_RATIO=100

# Rate limits (per user, per minute; in-memory in Phase 1)
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_RETRY_PER_MINUTE=5
